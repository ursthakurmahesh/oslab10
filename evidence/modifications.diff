--- /tmp/xv6-orig-backup/vm.c	2026-11-03 15:26:42.446833413 +0530
+++ /tmp/repo/xv6/vm.c	2026-11-03 15:29:59.804491344 +0530
@@ -392,3 +392,54 @@
 //PAGEBREAK!
 // Blank page.
 
+// ------------------------------------------------------------------
+// Assignment 10, Q2(a)(b): translate a virtual address of the current
+// process into its physical address using walkpgdir(). Returns -1 if
+// the address has no valid, present page-table entry.
+int
+vtop(uint va)
+{
+  pte_t *pte;
+
+  // locate the page-table entry without creating missing tables
+  pte = walkpgdir(myproc()->pgdir, (void*)va, 0);
+  if(pte == 0 || !(*pte & PTE_P))   // entry missing or page not present
+    return -1;
+  // physical frame address | page offset = complete physical address
+  return (int)(PTE_ADDR(*pte) | (va & 0xFFF));
+}
+
+// Assignment 10, Q3(a): report mapping, physical frame number and the
+// page-table flags (P, W, U) for a virtual address of the current process.
+int
+pageinfo(uint va)
+{
+  pte_t *pte;
+
+  pte = walkpgdir(myproc()->pgdir, (void*)va, 0);
+  if(pte == 0 || !(*pte & PTE_P)){
+    cprintf("pageinfo: virtual address 0x%x is not mapped\n", va);
+    return -1;
+  }
+  cprintf("pageinfo: va 0x%x -> frame %d (pa 0x%x) flags:%s%s%s\n",
+          va, PTE_ADDR(*pte) >> 12, PTE_ADDR(*pte) | (va & 0xFFF),
+          (*pte & PTE_P) ? " P" : "",
+          (*pte & PTE_W) ? " W" : "",
+          (*pte & PTE_U) ? " U" : "");
+  return 0;
+}
+
+// Assignment 10, Q3(b): remove write permission (PTE_W) from the
+// page-table entry for a virtual address of the current process.
+int
+setreadonly(uint va)
+{
+  pte_t *pte;
+
+  pte = walkpgdir(myproc()->pgdir, (void*)va, 0);
+  if(pte == 0 || !(*pte & PTE_P))
+    return -1;
+  *pte &= ~PTE_W;                  // clear the writable bit
+  lcr3(V2P(myproc()->pgdir));      // flush the TLB so the new permission applies
+  return 0;
+}
