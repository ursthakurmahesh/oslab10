+// Assignment 10, Q1(b): number of pages currently sitting on the free
+// list - the exact count of available physical memory pages.
+int
+kfree_pages(void)
+{
+  struct run *r;
+  int n = 0;
+
+  if(kmem.use_lock)
+    acquire(&kmem.lock);
+  for(r = kmem.freelist; r; r = r->next)
+    n++;
+  if(kmem.use_lock)
+    release(&kmem.lock);
+  return n;
+}
