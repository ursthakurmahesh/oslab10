+  cprintf("memstats: total freed pages = %d\n", total_free);
+  cprintf("memstats: currently allocated pages = %d\n", current);
+  cprintf("memstats: available physical memory pages = %d (of %d total frames)\n",
+          available, total_frames);
+  return 0;
+}
